<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="480.0" prefWidth="500.0" style="-fx-background-color: #9EE4E8;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.registro.RegistroClienteController">
    <children>
        <Label layoutX="140.0" layoutY="14.0" text="Registro de Cliente">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <Line endX="380.0" layoutX="60.0" layoutY="45.0" opacity="0.3" startX="-100.0" />

        <Label layoutX="15.0" layoutY="55.0" text="Nombre" />
        <TextField fx:id="txtNombre" layoutX="14.0" layoutY="76.0" prefHeight="26.0" prefWidth="460.0" promptText="Nombre completo del cliente" style="-fx-background-color: #EDF3F5;" />

        <Label layoutX="15.0" layoutY="110.0" text="Correo" />
        <TextField fx:id="txtCorreo" layoutX="14.0" layoutY="131.0" prefHeight="26.0" prefWidth="460.0" promptText="correo@ejemplo.com" style="-fx-background-color: #EDF3F5;" />

        <Label layoutX="15.0" layoutY="165.0" text="Teléfono" />
        <TextField fx:id="txtTelefono" layoutX="14.0" layoutY="186.0" prefHeight="26.0" prefWidth="460.0" promptText="Número de teléfono" style="-fx-background-color: #EDF3F5;" />

        <Label layoutX="15.0" layoutY="220.0" text="Tipo de cliente" />
        <ComboBox fx:id="cbTipoCliente" layoutX="14.0" layoutY="241.0" prefHeight="26.0" prefWidth="460.0" promptText="Seleccione el tipo de cliente" />

        <Label layoutX="15.0" layoutY="275.0" text="Documento de identificación" />
        <TextField fx:id="txtDocumento" editable="false" layoutX="14.0" layoutY="296.0" prefHeight="26.0" prefWidth="360.0" promptText="Seleccione un archivo" style="-fx-background-color: #EDF3F5;" />
        <Button fx:id="btnSeleccionarDocumento" layoutX="382.0" layoutY="296.0" mnemonicParsing="false" onAction="#seleccionarDocumento" text="Seleccionar" />

        <Label layoutX="15.0" layoutY="330.0" text="Directorio del cliente" />
        <TextField fx:id="txtDirectorio" editable="false" layoutX="14.0" layoutY="351.0" prefHeight="26.0" prefWidth="360.0" promptText="Seleccione un directorio" style="-fx-background-color: #EDF3F5;" />
        <Button fx:id="btnSeleccionarDirectorio" layoutX="382.0" layoutY="351.0" mnemonicParsing="false" onAction="#seleccionarDirectorio" text="Seleccionar" />

        <Line endX="380.0" layoutX="60.0" layoutY="390.0" opacity="0.3" startX="-100.0" />

        <Button fx:id="btnGuardar" layoutX="14.0" layoutY="410.0" mnemonicParsing="false" onAction="#guardarCliente" text="Guardar" />
        <Button fx:id="btnCrearSolicitud" layoutX="110.0" layoutY="410.0" mnemonicParsing="false" onAction="#crearSolicitud" text="Crear solicitud" />
        <Button fx:id="btnLimpiar" layoutX="240.0" layoutY="410.0" mnemonicParsing="false" onAction="#limpiarCliente" text="Limpiar" />
        <Button fx:id="btnCerrar" layoutX="330.0" layoutY="410.0" mnemonicParsing="false" onAction="#cerrarCliente" text="Cerrar" />
    </children>
</AnchorPane>
