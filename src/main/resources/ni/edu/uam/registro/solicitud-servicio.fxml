<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="640.0" prefWidth="520.0" style="-fx-background-color: #9EE4E8;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.registro.SolicitudServicioController">
    <children>
        <Label layoutX="140.0" layoutY="14.0" text="Solicitud de Servicio">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <Line endX="400.0" layoutX="60.0" layoutY="45.0" opacity="0.3" startX="-100.0" />

        <Label layoutX="15.0" layoutY="55.0" text="Cliente" />
        <TextField fx:id="txtCliente" layoutX="14.0" layoutY="76.0" prefHeight="26.0" prefWidth="480.0" promptText="Nombre del cliente" style="-fx-background-color: #EDF3F5;" />

        <Label layoutX="15.0" layoutY="110.0" text="Correo del cliente" />
        <TextField fx:id="txtCorreoCliente" layoutX="14.0" layoutY="131.0" prefHeight="26.0" prefWidth="480.0" promptText="correo@ejemplo.com" style="-fx-background-color: #EDF3F5;" />

        <Label layoutX="15.0" layoutY="165.0" text="Tipo de cliente" />
        <TextField fx:id="txtTipoCliente" layoutX="14.0" layoutY="186.0" prefHeight="26.0" prefWidth="480.0" promptText="Tipo de cliente" style="-fx-background-color: #EDF3F5;" />

        <Label layoutX="15.0" layoutY="220.0" text="Asunto" />
        <TextField fx:id="txtAsunto" layoutX="14.0" layoutY="241.0" prefHeight="26.0" prefWidth="480.0" promptText="Asunto de la solicitud" style="-fx-background-color: #EDF3F5;" />

        <Label layoutX="15.0" layoutY="275.0" text="Tipo de servicio" />
        <ComboBox fx:id="cbTipoServicio" layoutX="14.0" layoutY="296.0" prefHeight="26.0" prefWidth="480.0" promptText="Seleccione el tipo de servicio" style="-fx-background-color: #EDF3F5;" />

        <Label layoutX="15.0" layoutY="330.0" text="Prioridad" />

        <RadioButton fx:id="rbAlta" layoutX="14.0" layoutY="352.0" mnemonicParsing="false" text="Alta" />
        <RadioButton fx:id="rbMedia" layoutX="100.0" layoutY="352.0" mnemonicParsing="false" text="Media" />
        <RadioButton fx:id="rbBaja" layoutX="190.0" layoutY="352.0" mnemonicParsing="false" text="Baja" />

        <Label layoutX="15.0" layoutY="380.0" text="Descripción del problema" />
        <TextArea fx:id="txtDescripcion" layoutX="14.0" layoutY="401.0" prefHeight="80.0" prefWidth="480.0" promptText="Describa el problema" style="-fx-background-color: #EDF3F5;" />

        <Label layoutX="15.0" layoutY="490.0" text="Archivo adjunto" />
        <TextField fx:id="txtArchivoAdjunto" editable="false" layoutX="14.0" layoutY="511.0" prefHeight="26.0" prefWidth="380.0" promptText="Seleccione un archivo" style="-fx-background-color: #EDF3F5;" />
        <Button fx:id="btnSeleccionarArchivo" layoutX="402.0" layoutY="511.0" mnemonicParsing="false" onAction="#seleccionarArchivoAdjunto" text="Seleccionar" />

        <Label layoutX="15.0" layoutY="545.0" text="Carpeta de evidencias" />
        <TextField fx:id="txtCarpetaEvidencias" editable="false" layoutX="14.0" layoutY="566.0" prefHeight="26.0" prefWidth="380.0" promptText="Seleccione una carpeta" style="-fx-background-color: #EDF3F5;" />
        <Button fx:id="btnSeleccionarCarpeta" layoutX="402.0" layoutY="566.0" mnemonicParsing="false" onAction="#seleccionarCarpetaEvidencias" text="Seleccionar" />

        <Line endX="400.0" layoutX="60.0" layoutY="600.0" opacity="0.3" startX="-100.0" />

        <Button fx:id="btnGuardar" layoutX="14.0" layoutY="610.0" mnemonicParsing="false" onAction="#guardarSolicitud" text="Guardar" />
        <Button fx:id="btnCrearSolicitud" layoutX="110.0" layoutY="610.0" mnemonicParsing="false" onAction="#crearSolicitud" text="Crear solicitud" />
        <Button fx:id="btnLimpiar" layoutX="240.0" layoutY="610.0" mnemonicParsing="false" onAction="#limpiarSolicitud" text="Limpiar" />
        <Button fx:id="btnCerrar" layoutX="330.0" layoutY="610.0" mnemonicParsing="false" onAction="#cerrarSolicitud" text="Cerrar" />
    </children>
</AnchorPane>
